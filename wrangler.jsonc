{
  "name": "jeopardy", "main": "src/worker.ts", "compatibility_date": "2026-09-25",
  "durable_objects": {"bindings": [{"name": "ROOM", "class_name": "Room"}, {"name": "RATE_LIMIT", "class_name": "RateLimit"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Room"]}, {"tag": "v2", "new_sqlite_classes": ["RateLimit"]}],
  "assets": {"directory": "./dist", "binding": "ASSETS"},
  "observability": {"enabled": true}
}
